# Production Environment Configuration for Hostinger/EasyPanel
# IMPORTANT: Update these values before deploying!

# API Configuration
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=bkr-secret-key-2025-change-in-production

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# Database Configuration
DATABASE_PATH=bkr_database.db

# Server Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# CORS Origins - Add your domain
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*
